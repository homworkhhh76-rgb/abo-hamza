# Required. Set the existing office password to preserve the original sign-in and Telegram media access.
TAXI_ADMIN_PASSWORD=
PORT=3000

# Existing Turso instance is carried over from V5.
# Set TAXI_LEGACY_PASSWORD if the new ADMIN password differs and no database token is supplied.
# TAXI_LEGACY_PASSWORD=
# To override the existing Turso connection, set both URL and token:
# TURSO_URL=libsql://YOUR_DATABASE.turso.io
# TURSO_AUTH_TOKEN=

# Optional WhatsApp Business Cloud API webhook
# META_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Local testing only. Leave commented for the shared Turso database.
# TAXI_LOCAL_DB=taxi-test.sqlite
